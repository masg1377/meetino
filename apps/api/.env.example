# API-specific environment variables.
# In dev, the API loads from the repo root .env file.
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

DATABASE_URL=postgresql://meetino:meetino_dev_password_change_me@localhost:5432/meetino?schema=public

REDIS_URL=redis://localhost:6379

WEB_ORIGIN=http://localhost:3000

# JWT — used in Phase 2
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
