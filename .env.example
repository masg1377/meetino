# ─────────────────────────────────────────────────────────────
# Meetino — Root environment reference
# Copy this to `.env` (or use the per-app .env.example files).
# Docker Compose reads from this file.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ──
POSTGRES_USER=meetino
POSTGRES_PASSWORD=meetino_dev_password_change_me
POSTGRES_DB=meetino
POSTGRES_PORT=5432

# ── Redis ──
REDIS_PORT=6379
REDIS_PASSWORD=

# ── API (NestJS) ──
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgresql://meetino:meetino_dev_password_change_me@localhost:5432/meetino?schema=public
REDIS_URL=redis://localhost:6379

# Web origin allowed for CORS
WEB_ORIGIN=http://localhost:3000

# JWT (used in Phase 2 — placeholders for now)
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── LiveKit (Phase 6 — self-hosted SFU) ──
# Must match the `keys:` block in infra/docker/livekit/livekit.yaml.
# The API_SECRET must be at least 32 chars.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=meetino_dev_only_secret_change_me_for_prod_min32chars_abcdef
# WS URL the backend hands back to clients. ws:// for local, wss:// for prod.
LIVEKIT_URL=ws://localhost:7880
# How long a LiveKit join token is valid for (minutes).
LIVEKIT_TOKEN_TTL_MINUTES=360

# ── Web (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_NAME=Meetino
# Optional Phase 4 override for the realtime WebSocket origin.
# Leave blank to derive from NEXT_PUBLIC_API_URL by stripping a trailing /api.
NEXT_PUBLIC_WS_URL=
# Public LiveKit WS URL for the browser. Backend echoes its own LIVEKIT_URL
# in the token response; this is a fallback only.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
