# ─────────────────────────────────────────────────────────────
# Meetino — production environment template
#
# Copy to `.env.production` at the repo root, then fill in real values.
# docker compose -f infra/docker/docker-compose.prod.yml --env-file ../../.env.production up -d
#
# Strong secrets:
#   openssl rand -hex 32       (32 bytes hex → 64 chars; good for JWT/turn)
#   openssl rand -base64 32    (32 bytes base64 → 44 chars)
#
# NEVER commit a real .env.production. Only the .example file is tracked.
# ─────────────────────────────────────────────────────────────

# ── Domains ─────────────────────────────────────────────────────────
DOMAIN=meetino.example.com
API_DOMAIN=api.meetino.example.com
LIVEKIT_DOMAIN=livekit.meetino.example.com
TURN_DOMAIN=turn.meetino.example.com
SERVER_IP=YOUR_SERVER_IP
SSL_EMAIL=admin@example.com

# ── Postgres (internal only — never publish 5432) ───────────────────
POSTGRES_USER=meetino
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=meetino

# ── Redis (internal only) ───────────────────────────────────────────
# Leave REDIS_PASSWORD blank for no auth (still firewalled inside the
# bridge network), or set a long string to require AUTH.
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ── API ─────────────────────────────────────────────────────────────
NODE_ENV=production
WEB_ORIGIN=https://${DOMAIN}

# JWT — use `openssl rand -hex 32` for each (must be at least 32 chars).
JWT_ACCESS_SECRET=CHANGE_ME_64HEX_GENERATE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_64HEX_GENERATE_WITH_openssl_rand_hex_32_DIFFERENT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional — set if you want session cookies to span subdomains (e.g.
# api.${DOMAIN} sets a cookie that web.${DOMAIN} can read). Otherwise
# leave blank to keep the default host-only cookie.
COOKIE_DOMAIN=

# ── LiveKit ─────────────────────────────────────────────────────────
# These must match the `keys:` block in infra/docker/livekit/livekit.prod.yaml.
# API_SECRET must be ≥ 32 chars. Generate with `openssl rand -hex 32`.
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=CHANGE_ME_64HEX_GENERATE_WITH_openssl_rand_hex_32_LIVEKIT
LIVEKIT_URL=wss://${LIVEKIT_DOMAIN}
LIVEKIT_TOKEN_TTL_MINUTES=360

# ── coturn / TURN ───────────────────────────────────────────────────
# Long-term-credential shared secret. Must match coturn's static-auth-secret.
TURN_SHARED_SECRET=CHANGE_ME_64HEX_GENERATE_WITH_openssl_rand_hex_32_TURN
# Realm shown to TURN clients (any string; doesn't have to be a real host).
TURN_REALM=meetino

# ── Frontend (NEXT_PUBLIC_* are BAKED INTO THE BUILD) ───────────────
# Changing these requires `docker compose build web` again.
NEXT_PUBLIC_API_URL=https://${API_DOMAIN}/api
NEXT_PUBLIC_LIVEKIT_URL=wss://${LIVEKIT_DOMAIN}
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_APP_NAME=Meetino

# ── Uploads (Phase 7.7 file-sharing) ────────────────────────────────
# Inside the api container this path is fixed to /app/apps/api/storage/meeting-files
# and is backed by the named volume `meetino_prod_meeting_files`. The env
# variable below is only used to override the in-process limit.
MEDIA_MAX_FILE_BYTES=26214400

# ── Image tag for rolling deploys ───────────────────────────────────
# Bump this to pin a specific build (e.g. v1.2.3) instead of "latest".
IMAGE_TAG=latest
